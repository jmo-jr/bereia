{% comment %} {% render 'sideNav.liquid', theResource: '/biblia/', theBookName: bookName, theBookChapter: bookChapter %} {% endcomment %}

<div class="page-header bee">
	{% comment %} {% if bookChapter > 1 %}
	<a 
		href="{{ '/biblia/' | url }}{{ bookName | downcase }}/{{ bookChapter | minus: 1 }}"
		title="{{ bookName }} {{ bookChapter | minus: 1 }}">
	◄</a>
	{% else %}
	<a href="#">&nbsp;</a>
	{% endif %} {% endcomment %}
	<div class="page-header_title">
		<h3>{{bookName}} {{bookChapter}}</h3>
		{% comment %} <small><a href="/interlinear/{{bookAbbrev}}/{{bookChapter}}">Versão interlinear</a></small> {% endcomment %}
	</div>
	{% comment %} <a href="{{ '/biblia/' | url }}{{ bookName | downcase }}/{{ bookChapter | plus: 1 }}"
		title="{{ bookName }} {{ bookChapter | plus: 1 }}">►</a> {% endcomment %}
</div>
