---
title: Bíblia BEREIA
---
<!DOCTYPE html>
<html land="pt-br">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{ title }}</title>
	<base href="{{ pathPrefix }}">
  <meta name="description" content="Página do capítulo do livro escolhido">
  <meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="shortcut icon" href="{{ '/img/logo.png' | url }}">
  <link rel="stylesheet" href="//code.jquery.com/ui/1.13.1/themes/base/jquery-ui.css">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
	<link rel="stylesheet" href="{{ '/biblia/pagefind/pagefind-ui.css' | url }}">
	<link rel="stylesheet" href="{{ '/assets/css/tooltipster.bundle.min.css' | url }}">
	<link rel="stylesheet" href="{{ '/assets/css/tooltipster-sideTip-light.min.css' | url }}">
  <style>
    .ui-tooltip {
      padding: 4px 8px;
      background-color: lightyellow;
      font-size: 14px;
    }
  </style>
  <script src="https://code.jquery.com/jquery-3.6.0.js"></script>
  <script src="https://code.jquery.com/ui/1.13.1/jquery-ui.js"></script>
	<script src="{{ '/assets/js/tooltipster.bundle.min.js' | url }}"></script>
	<script src="{{ '/assets/js/tooltip-init.js' | url }}"></script>
  <script>
    $( function() {
      //$( document ).tooltip();
    } );
  </script>
</head>

<body>

  <div id="app" class="wrapper no_greenplaces no_bluecharacters">

    {% render 'siteHeader' %}

		{% assign interlinearBooks = ntBooks %}
		{% assign isLxxInterlinear = false %}
		{% assign routeParts = page.url | split: '/' %}
		{% if routeParts[1] == 'interlinear' %}
			{% assign interlinearBooks = atBooks | concat: ntBooks %}
			{% if entry.lxx == true %}{% assign isLxxInterlinear = true %}{% endif %}
		{% endif %}

		{% render 'toolBar', 
			lxx: isLxxInterlinear, bookList: interlinearBooks, bookName: bookName, bookNameAbbr: bookNameAbbr, bookChapter: bookChapter, type: bee | default: false 
		%}

		<div class="content-wrapper">
			<main class="main-content">
				<div class="content" data-pagefind-body>

					{% block content %}
						{{ content }}
					{% endblock %}

				</div>
			</main>

			{% unless bee %}
			<aside class="side-drawer" id="strong-drawer" tabindex="-1"
				aria-labelledby="strong-drawer-title" data-lexico-url="{{ '/assets/lexico/greek.json' | url }}">
				<header>
					<h1 id="strong-drawer-title"></h1>
					<button type="button" class="close-drawer" aria-label="Fechar verbete">
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 1.19992L10.8001 0L6 4.80008L1.19992 0L0 1.19992L4.80008 6L0 10.8001L1.19992 12L6 7.19992L10.8001 12L12 10.8001L7.19992 6L12 1.19992Z" fill="lightgrey" /></svg>
					</button>
				</header>
				<div class="drawer-body" aria-live="polite"></div>
			</aside>
			{% endunless %}
		</div>

    <script src="{{ '/assets/js/strong-drawer.js' | url }}" defer></script>

  </div>

	<div class="feedback-component">
		<button type="button" onclick="toggleMenu(feedbackWindow, this)">📢 Feedback</button>

		<div class="feedback-options">
			<p>Queremos te ouvir!</p>
			<button id="bugReport" type="button">🚨 Relate um erro</button>
			<button id="featureRequest" type="button">🌟 Sugira uma funcionalidade</button>
			<button id="helpUs" type="button">🫰 Apoie nosso trabalho</button>
		</div>
	</div>

  <!-- SCRIPTS -->
  <script>
    var page = document.getElementById("app");
		
		function toggleText(checkbox, classe) {
      page.classList.toggle(classe, !checkbox.checked);
    }
		
		function toggleMenu(nav, toggleBtn) {
			if (!toggleBtn || !nav) return;

			const opened = nav.classList.toggle('open');
			toggleBtn.setAttribute('aria-expanded', String(opened));
		}

		const mainNav = document.querySelector('.main-nav');
		const optionsDropdown = document.querySelector('.options-dropdown');
		const optionsDropdown2 = document.querySelector('.options-dropdown2');
		const feedbackWindow = document.querySelector('.feedback-options');
		const menuControls = [
			{ nav: mainNav, button: document.getElementById('toggleMenu') },
			{ nav: optionsDropdown, button: document.getElementById('optionsBt') },
			{ nav: optionsDropdown2, button: document.getElementById('optionsBt2') }
		].filter(({ nav, button }) => nav && button);

		menuControls.forEach(({ button }) => button.setAttribute('aria-expanded', 'false'));

		const closeMenusIfOutside = (event) => {
			menuControls.forEach(({ nav, button }) => {
				if (!nav.classList.contains('open')
					|| nav.contains(event.target)
					|| button.contains(event.target)) return;

				nav.classList.remove('open');
				button.setAttribute('aria-expanded', 'false');
			});
		};

		document.addEventListener('click', closeMenusIfOutside);
		document.addEventListener('touchstart', closeMenusIfOutside);
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;

			menuControls.forEach(({ nav, button }) => {
				if (!nav.classList.contains('open')) return;
				nav.classList.remove('open');
				button.setAttribute('aria-expanded', 'false');
				button.focus();
			});
		});
	</script>
	<script 
		src="{{ '/biblia/pagefind/pagefind-ui.js' | url }}" 
		onload="new PagefindUI({
			element: '#search', 
			showImages: false,
			pageSize: 10,
  		excerptLength: 12,
			translations: { 
				placeholder: 'Busca', 
				zero_results: 'Não encontrei [SEARCH_TERM]', 
				many_results: '[COUNT] resultados para [SEARCH_TERM]', 
				one_result: '[COUNT] resultado para [SEARCH_TERM]'
			}
		});">
	</script>
	{% if bee %}
	{% render 'notes' %}
	{% endif %}
</body>
</html>
