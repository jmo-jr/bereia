<header class="app-bar">
	<div class="content d-flex justify-between align-items-center">
		<div class="d-flex align-items-center" style="gap:10px;">
			<img src="{{ '/img/logo.png' | url }}" style="width:34px; height: 34px;">
			<h1><a href="{{ '/' | url }}">B.E.R.E.I.A.</a></h1>
		</div>

		<button type="button" id="toggleMenu" onclick="toggleMenu(mainNav, this)">
			<div class="burger-icon">
				<div class="burger-layer"></div>
				<div class="burger-layer"></div>
				<div class="burger-layer"></div>
			</div>
		</button>

		<nav class="main-nav">
			<ul>
				<li><a href="{{ '/biblia/mateus/1/' | url }}">NT de Estudo</a></li>
				<li><a href="{{ '/interlinear/mt/1/' | url }}">Bíblia Interlinear</a></li>
				<li><a href="{{ '/sobre/' | url }}">Sobre</a></li>
				{% comment %} <li>
					<label class="switch">
						<input type="checkbox" aria-label="Ativar tema escuro">
						<span class="slider round"></span>
						<span>Tema escuro</span>
					</label>
				</li> {% endcomment %}
			</ul>
		</nav>
	</div>
</header>
