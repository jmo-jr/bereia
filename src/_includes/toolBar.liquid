{% assign currentChapter = bookChapter | plus: 0 %}
<div class="toolbar">
	<div class="content">

		{% comment %} {% if type == true %}
		<h2 class="show-mobile">Bíblia de Estudo Exegético</h2>
		{% else %}
		<h2 class="show-mobile">{% if lxx %}LXX Interlinear Analítico{% else %}NT Interlinear Analítico{% endif %}</h2>
		{% endif %} {% endcomment %}

		<div class="d-flex justify-between align-items-center flex-wrap">

			{% comment %} Linha 1: Navegador dos livros {% endcomment %}
			<div class="input-group d-flex">

				<form>
					<select id="livro" name="livro" class="drop" onchange="location.href = this.value;">
						{% for livro in bookList %}
						{% assign selected_permalink = livro.permalink %}
						{% if type %}
							{% assign selected_permalink = livro.bkpermalink %}
						{% endif %}
						<option 
							value="{{ selected_permalink | url }}{% if livro.chapterNumbers != blank %}{{ livro.chapterNumbers.first }}{% else %}1{% endif %}"
							{% if bookName == livro.name %}selected{% endif %}
						>{{ livro.name }}</option>
						{% endfor %}
					</select>

					<select name="chapter" class="drop" onchange="location.href = this.value;">
						{% for book in bookList %}
						{% assign selected_permalink = book.permalink %}
						{% if type %}
							{% assign selected_permalink = book.bkpermalink %}
						{% endif %}
							{% if book.name == bookName %}
								{% assign num = book.chapters %}
								{% assign range = (1..num) %}
                                {% if book.chapterNumbers != blank %}{% assign range = book.chapterNumbers %}{% endif %}
								{% for n in range %}
									<option 
										value="{{ selected_permalink | url }}{{ n }}"
										{% if currentChapter == n %}selected{% endif %}
									>
										{{n}}
									</option>
								{% endfor %}
							{% endif %}
						{% endfor %}
					</select>

				</form>

				<div class="chapters-nav">
					{% comment %} {{ theResource | url }}{{ theBookName | downcase }}/{{ chapterNum | minus: 1 }}/ {% endcomment %}
					<button type="button"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 512"><path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L77.3 256 214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/></svg></button>

					<button type="button"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 512"><path d="M247.1 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L179.2 256 41.9 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"/></svg></button>
				</div>
			</div>

			{% if type %}
			<h2 class="show-desktop">Bíblia de Estudo Exegético</h2>
			{% else %}
			<h2 class="show-desktop">{% if lxx %}AT Grego (LXX) Interlinear Analítico{% else %}NT Majoritário Interlinear Analítico{% endif %}</h2>
			{% endif %}

			{% comment %} Linha 2: Configurações de tela {% endcomment %}
			{% if type %}
			<div class="options-container">
				<div id="search" class="search"></div>
				{% unless lxx %}
				<div class="options-group">
					<button id="optionsBt" class="square" type="button" title="Opções de exibição" onclick="toggleMenu(optionsDropdown, this)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M96 128C78.3 128 64 142.3 64 160C64 177.7 78.3 192 96 192L182.7 192C195 220.3 223.2 240 256 240C288.8 240 317 220.3 329.3 192L544 192C561.7 192 576 177.7 576 160C576 142.3 561.7 128 544 128L329.3 128C317 99.7 288.8 80 256 80C223.2 80 195 99.7 182.7 128L96 128zM96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L342.7 352C355 380.3 383.2 400 416 400C448.8 400 477 380.3 489.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L489.3 288C477 259.7 448.8 240 416 240C383.2 240 355 259.7 342.7 288L96 288zM96 448C78.3 448 64 462.3 64 480C64 497.7 78.3 512 96 512L150.7 512C163 540.3 191.2 560 224 560C256.8 560 285 540.3 297.3 512L544 512C561.7 512 576 497.7 576 480C576 462.3 561.7 448 544 448L297.3 448C285 419.7 256.8 400 224 400C191.2 400 163 419.7 150.7 448L96 448z" fill="white"/></svg></button>
					<div class="options-dropdown">
						<div><input id="strongBt" name="strongs" type="checkbox" title="Desmarque para ocultar números Strong" onchange="toggleText(this, 'no_redletter')" checked> <label for="strongs">Palavras de Jesus em vermelho</label></div>

						<div><input id="translitBt" type="checkbox" title="Desmarque para ocultar transliteração" onchange="toggleText(this, 'no_greenplaces')"> <label>Locais em verde</label></div>
						
						<div><input id="greekBt" type="checkbox" title="Desmarque para ocultar traduções" onchange="toggleText(this, 'no_bluecharacters')"> <label>Personagens em azul</label></div>
					</div>
				</div>
				{% endunless %}
			</div>
			{% else %}
			<div class="options-container">
				<div id="search" class="search"></div>
				<div class="options-group">
					<button id="optionsBt2" class="square" type="button" title="Opções de exibição" onclick="toggleMenu(optionsDropdown2, this)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M96 128C78.3 128 64 142.3 64 160C64 177.7 78.3 192 96 192L182.7 192C195 220.3 223.2 240 256 240C288.8 240 317 220.3 329.3 192L544 192C561.7 192 576 177.7 576 160C576 142.3 561.7 128 544 128L329.3 128C317 99.7 288.8 80 256 80C223.2 80 195 99.7 182.7 128L96 128zM96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L342.7 352C355 380.3 383.2 400 416 400C448.8 400 477 380.3 489.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L489.3 288C477 259.7 448.8 240 416 240C383.2 240 355 259.7 342.7 288L96 288zM96 448C78.3 448 64 462.3 64 480C64 497.7 78.3 512 96 512L150.7 512C163 540.3 191.2 560 224 560C256.8 560 285 540.3 297.3 512L544 512C561.7 512 576 497.7 576 480C576 462.3 561.7 448 544 448L297.3 448C285 419.7 256.8 400 224 400C191.2 400 163 419.7 150.7 448L96 448z" fill="white"/></svg></button>

					<div class="options-dropdown2">
						<div><input id="strongBt" name="strongs" type="checkbox" title="Desmarque para ocultar números Strong" onchange="toggleText(this, 'no_strongs')" checked> <label for="strongs">Exibir Strongs</label></div>

						<div><input id="translitBt" type="checkbox" title="Desmarque para ocultar transliteração" onchange="toggleText(this, 'no_translit')" checked> <label>Exibir transliteração</label></div>
						
						<div><input id="greekBt" type="checkbox" title="Desmarque para ocultar traduções" onchange="toggleText(this, 'no_greek')" checked> <label>Exibir traduções</label></div>
						
						<div><input id="gramBt" type="checkbox" title="Desmarque para ocultar morfologia" onchange="toggleText(this, 'no_grammar')" checked> <label></label>Exibir morfolofia</label></div>
					</div>
				</div>
			</div>
			{% endif %}

			<div class="tool-selector">
				<div class="button-group">
					<a class="group-button {% if type %}active{% endif %}" href="{{ '/biblia/mateus/1/' | url }}">NT de Estudo</a>

					<a class="group-button {% unless type %}active{% endunless %}" href="{{ '/interlinear/mt/1/' | url }}">Bíblia Interlinear</a>
				</div>
			</div>

		</div>

	</div>
</div>