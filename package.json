{
  "name": "interlinear-bible",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/dictionary/*.test.js",
    "bible:global:export": "node tools/bible-global/global.js export",
    "bible:global:import": "node tools/bible-global/global.js import",
    "test:bible:global": "node --test tools/bible-global/*.test.js",
    "test:bible": "node --test tools/bible-global/*.test.js tools/bible-build.test.js",
    "test:flexiona": "python3 -B -m unittest discover -s tests -p test_flexiona_scripts.py -v",
    "dict:generate": "node tools/dictionary/generate.js",
    "dict:check": "node tools/dictionary/generate.js --check",
    "dict:compare-tm": "node tools/dictionary/compare-tm.js",
    "dict:review-state": "node tools/dictionary/update-review-state.js",
    "dict:review-state:check": "node tools/dictionary/update-review-state.js --check",
    "dict:review-coverage": "node tools/dictionary/review-coverage.js",
    "dict:review-coverage:check": "node tools/dictionary/review-coverage.js --check",
    "build": "env NODE_OPTIONS=--max-old-space-size=4096 NODE_ENV=production npx eleventy",
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 eleventy --serve",
		"dev:inc": "NODE_OPTIONS=--max-old-space-size=4096 eleventy --serve --incremental",
    "serve": "node server.js",
    "dev:full": "NODE_OPTIONS=--max-old-space-size=4096 eleventy --serve & node server.js",
		"watch": "NODE_OPTIONS=--max-old-space-size=4096 npx @11ty/eleventy --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "pagefind": "^1.4.0"
  },
  "dependencies": {
    "consolelogger": "^1.0.4",
    "express": "^5.2.1",
    "tooltipster": "^4.2.8"
  }
}
